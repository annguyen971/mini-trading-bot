# .env.example
# Copy this file to .env and fill in the values.

# -- DATABASE --
POSTGRES_USER=hunter
POSTGRES_PASSWORD=
POSTGRES_DB=hunter
# The full connection string used by the application code in core_lib
DB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# -- SECURITY --
ADMIN_KEY=
BASIC_AUTH_HASH=

# -- PROXY --
PROXY_URL=

# -- MACRO LOGIC (Point 9) --
ENABLE_MACRO_BLEND=true
MACRO_TZ=Asia/Ho_Chi_Minh
